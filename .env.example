# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Base de datos
POSTGRES_DB=reactor
POSTGRES_USER=reactor
POSTGRES_PASSWORD=cambiar_esto
DATABASE_URL=postgresql://reactor:cambiar_esto@db:5432/reactor

# Backend
BACKEND_PORT=8080
JWT_SECRET=cambiar_esto

# Correo (Mailpit en desarrollo)
SMTP_HOST=mail
SMTP_PORT=1025
MAIL_FROM=no-reply@controldelreactor.local

# Hardware (Arduino por puerto serial)
HARDWARE_PROTOCOL=serial
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=9600
